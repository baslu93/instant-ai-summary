{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Test Scratch Org",
            "type": "shell",
            "command": "bash test/scripts/setup.sh ${input:deployMode}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ],
    "inputs": [
        {
            "id": "deployMode",
            "type": "pickString",
            "description": "Deploy mode",
            "options": ["source", "package"],
            "default": "source"
        }
    ]
}
